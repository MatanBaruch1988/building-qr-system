{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.vercel/**)",
      "Bash(gh pr merge *)",
      "Bash(vercel --prod *)",
      "Bash(vercel deploy --prod *)",
      "Bash(vercel env pull *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(gh release create *)",
      "Bash(gh release edit *)",
      "Bash(gh release delete *)",
      "Bash(gh release upload *)",
      "Bash(gh workflow run release.yml *)",
      "Bash(gh workflow run Release *)",
      "Bash(git tag *)",
      "Bash(git push *--tags*)",
      "Bash(git push *--follow-tags*)",
      "Bash(git push * tag *)",
      "Bash(git push *refs/tags/*)",
      "Bash(git push origin v*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/check-edit.mjs\"", "timeout": 30 }
        ]
      }
    ]
  }
}
