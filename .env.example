# Copy to .env.local for local development. Never commit real values.
# On Vercel these are set in Project → Settings → Environment Variables.

# Postgres (Neon). Pooled URL for the app; the direct (UNPOOLED) one is used by the tests and scratch schemas.
# These MUST point at a NON-production database, for example a separate free Neon project. Never run
# `vercel env pull` from Production into .env.local. The tests, the dev seed, the local API server and the local
# scripts refuse a database marked as production (server/dbGuard.js) and an env file pulled from Vercel production
# (server/loadEnv.js). Adding the first committee member to a deployment is described in README.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Committee sign-in with Google: the OAuth "Web application" client id (public value, not a secret).
# Create it at console.cloud.google.com → APIs & Services → Credentials, and add your site's address
# (https://your-domain and http://localhost:3000) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Public address printed inside NEW QR codes (no trailing slash). Old printed QRs keep working
# because their tokens are preserved; only NEW QR codes use this base. Set it in production.
APP_BASE_URL=https://your-domain.example

# The e-mail address of the first committee member of a deployment (personal data, not a secret). Set it only in the Production
# environment of Vercel, redeploy, and remove it after that person's first Google sign-in: while the committee list has no row, the
# first sign-in with exactly this address adds that member (server/firstAdmin.js, docs/runbooks/secrets.md). It is not needed
# locally: the dev seed has its own members, and from the first member on the variable does nothing.
# FIRST_ADMIN_EMAIL=

# The ping address of the server's check on healthchecks.io (a secret). Set only in the Production environment of Vercel
# (marked sensitive), never here: without it the server sends nothing, which is right for every local run and test.
# HEALTH_HEARTBEAT_URL=

# Local development only ---------------------------------------------------------------------------
# Local API server port (npm run dev:api). Vite proxies /api to it.
API_PORT=3001
# `node server/dev.mjs --schema=dev_ui` (scratch schema, see scripts/dev-seed.mjs) also switches on a
# dev-only admin sign-in that skips Google. It never works on Vercel.
